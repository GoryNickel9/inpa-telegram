[Unit]
Description=inPA metadata synchronization
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=inpa-bot
Group=inpa-bot
WorkingDirectory=/opt/inpa-telegram
EnvironmentFile=/etc/inpa-bot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/inpa-telegram/.venv/bin/python -m inpa_bot --db /var/lib/inpa-bot/inpa.sqlite3 watch --user-agent ${INPA_USER_AGENT}
Restart=on-failure
RestartSec=30s
TimeoutStopSec=300s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/inpa-bot

[Install]
WantedBy=multi-user.target
